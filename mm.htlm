    </main>

    <div id="flyerModal" class="modal" onclick="closeModal()">
        <div class="modal-content" onclick="event.stopPropagation()">
            <span class="close-btn" onclick="closeModal()">&times;</span>
            <iframe id="flyerFrame" src="" frameborder="0"></iframe>
        </div>
    </div>

    <script>
        function openFlyer(fileUrl) {
            document.getElementById('flyerFrame').src = fileUrl;
            document.getElementById('flyerModal').style.display = "flex";
        }
        function closeModal() {
            document.getElementById('flyerModal').style.display = "none";
            document.getElementById('flyerFrame').src = "";
        }
    </script>
</body>
</html>

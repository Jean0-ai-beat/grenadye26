<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grenadiers Hub - Qatar 2026</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="main-header">
        <div class="flag-top">
            <div class="blue-bar"></div>
            <div class="red-bar"></div>
        </div>
        <h1>GRENADIERS HUB</h1>
        <p class="subtitle">EFFECTIF OFFICIEL — OBJECTIF MONDIAL 2026</p>
    </header>

    <main class="hub-container">
        
        <h2 class="section-title">GARDIENS</h2>
        <div class="player-grid">
            <div class="player-card" onclick="openFlyer('flyer_johny_placide_tiktok.html')">
                <div class="card-accent bg-blue"></div>
                <div class="player-number">01</div>
                <div class="player-info">
                    <span class="player-pos">GARDIEN / CAPITAINE</span>
                    <h3>Johny Placide</h3>
                    <p class="player-club">SC Bastia 🇫🇷</p>
                </div>
            </div>
            <div class="player-card" onclick="openFlyer('flyer_alexandre_pierre_tiktok.html')">
                <div class="card-accent bg-blue"></div>
                <div class="player-number">16</div>

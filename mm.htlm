                    <span class="player-pos">GARDIEN</span>
                    <h3>Alexandre Pierre</h3>
                    <p class="player-club">FC Sochaux-Montbéliard 🇫🇷</p>
                </div>
            </div>
            <div class="player-card" onclick="openFlyer('flyer_josue_duverger_tiktok.html')">
